node_modules/
dist/
.env
.env.local
*.log
npm-debug.log*

# Server-specific Docker Compose settings (e.g. Postgres memory tuning, see
# docs/migration-guide.md §14) — read automatically by `docker compose`,
# never tracked, so updates don't conflict with them.
docker-compose.override.yml

# engine
engine/dist/
engine/.backup-ssh/

# agent build output + local config (holds a real agent key)
agent/bin/
agent/signing.env
agent/looksee-agent
agent/looksee-agent.exe
agent/looksee-agent.yaml

# dashboard (Next.js)
dashboard/.next/
dashboard/out/
dashboard/*.tsbuildinfo
# regenerated on every `next dev`/`next build`, and differs between the two —
# tracking it just causes spurious merge conflicts across machines/servers
dashboard/next-env.d.ts

.DS_Store
Thumbs.db

# Security gate reports describe unpatched weaknesses; never commit them
# (this repository is public).
security-reports/
