# Copy to .env (gitignored) and fill in real values.

# Postgres connection string. Matches the docker-compose defaults for local dev.
DATABASE_URL=postgres://looksee:looksee@localhost:5432/looksee

# Port the engine's HTTP server listens on.
PORT=4100

# Comma-separated list of origins allowed to call the API with credentials
# (the dashboard's own origin(s)). No default — must be set explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:3100

# This engine's own public URL, reachable by hosts you want to monitor.
# Used to build the one-line agent install command shown after generating
# a host's agent key, and served inside the bootstrap script itself so a
# freshly-curl'd agent knows where to report to. In the same-origin,
# path-routed Caddy setup from the deployment guide, this is the same
# public domain as the dashboard.
PUBLIC_URL=http://localhost:4100

# How long structured log entries (visible on the dashboard's /logs page)
# are kept before a daily job prunes them. Doesn't affect stdout/pm2 logs.
LOOKSEE_LOG_RETENTION_DAYS=30

# Random 32+ byte string used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Outbound email (used for the "email" alert channel type). Any
# SMTP-compatible provider works. This is now a FALLBACK — the real,
# discoverable way to set this is the SMTP settings form on the dashboard's
# Channels page (write-only password, same pattern as the Backups settings),
# which takes priority per-field over whatever's set here. Leave these blank
# and use the dashboard instead unless you specifically want it baked into
# the deploy config.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Looksee <looksee@example.com>"

# Web Push (dashboard PWA notifications). Generate a keypair once with:
#   npx web-push generate-vapid-keys
# and never regenerate it after real subscriptions exist — every existing
# browser subscription is tied to this specific public key and would need
# to re-subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Event and flow receivers (3.0) ---
# Unprivileged ports so the engine never needs root. Set any to "off" to
# disable that listener. Open them to your LAN only (deployment guide §5).
SNMP_TRAP_PORT=1162
SYSLOG_PORT=1514
FLOW_PORT=2055
SFLOW_PORT=6343
# Comma-separated CIDRs allowed to send traps/syslog/flows. Default (blank)
# = private address space only. "*" allows any source — not recommended.
RECEIVER_ALLOWED_SOURCES=
# Sources that are a remote site's public IP (Endpoints page → Public IPs)
# are always accepted too, and their events filed under that site ("direct
# push"). That needs these ports forwarded to the engine at its own site.

# --- Site collectors (3.2) ---
# Receiver ports a site collector listens on at its site. Same defaults as
# the engine's own; unprivileged so a Linux collector (an unprivileged
# service) can bind them — see the user guide for using 514/162 instead.
# "off" disables that listener on every collector.
COLLECTOR_SYSLOG_PORT=1514
COLLECTOR_TRAP_PORT=1162
COLLECTOR_FLOW_PORT=2055
COLLECTOR_SFLOW_PORT=6343
# CIDRs a collector accepts traps/syslog/flows from. Blank = private
# address space only.
COLLECTOR_ALLOWED_SOURCES=

# --- Data retention (days), applied by a daily cleanup job ---
# Check results (SLA reports read these; their detail blobs are dropped
# after 7 days regardless).
CHECK_RESULT_RETENTION_DAYS=400
HOST_METRICS_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
FLOW_RETENTION_DAYS=7

# Chrome/Chromium for "Real browser" checks. Blank = look in the standard
# install locations (e.g. /usr/bin/chromium).
CHROME_PATH=
