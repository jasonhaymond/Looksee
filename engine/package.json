{
  "name": "looksee-engine",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:collector": "node scripts/bundle-collector.mjs",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:create-admin": "tsx src/db/createAdmin.ts",
    "security:reset": "tsx src/db/securityReset.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "imapflow": "^2.4.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "net-snmp": "^3.29.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.13.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
