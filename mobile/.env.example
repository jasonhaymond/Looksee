# mobile/.env.example
# Settings for building the Looksee Android app on the build server
# (scripts/build-android.mjs). Copy to mobile/.env, which is gitignored, on the
# machine that runs the build, and keep the real values only there.
#
# The app itself has no build-time settings: the Looksee server address is typed
# in on the phone at sign-in.

# The build server's API address, e.g. https://builds-api.example.com
BUILD_SERVER_API_URL=

# An API key from the build server (Profile > My API keys). It needs these scopes:
# build:create, build:read, build:logs, artifact:download, signing:use
BUILD_SERVER_API_KEY=

# The NAME of the Android signing key stored on the build server. The key itself
# never leaves the build server. Required for release builds. It must stay the
# same for every release, or phones refuse to install the update.
BUILD_SERVER_SIGNING_KEY=looksee
