# Root-level overrides for docker-compose.yml only. Copy to `.env` (gitignored)
# and edit if this host already has something on port 5432.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Read by scripts/update.sh: which Node.js runtimes to prepare for site
# collectors (agents download the one for their platform). Blank = all five
# (about 200 MB on disk). Space-separated, e.g.
#   COLLECTOR_PLATFORMS="linux-amd64 windows-amd64"
COLLECTOR_PLATFORMS=

# Read by scripts/update.sh: the public address of this Looksee (through the
# reverse proxy), for the post-deploy security checks it runs after every
# update — HTTPS, certificate, security headers, admin routes refusing
# anonymous requests, CORS, sign-in rate limiting. Blank = skip them.
#   LOOKSEE_PUBLIC_URL=https://looksee.example.com
LOOKSEE_PUBLIC_URL=
