# Copy to signing.env (gitignored) on the machine that builds the agents
# (the Looksee server: scripts/update.sh runs build-all.sh). Leave
# SIGN_METHOD blank to build unsigned. See docs/windows-agent-security.md.

# azure | jsign | pfx | (blank = don't sign)
SIGN_METHOD=

# --- pfx: a .pfx file (an internal/enterprise CA's certificate, or an older
# public one — public certificates are no longer issued as files) ---
# Keep both files outside the repo, readable only by the account that runs
# updates (chmod 600).
SIGN_PFX=
SIGN_PFX_PASSWORD_FILE=

# --- jsign: a key in an HSM, USB token or cloud key service ---
# Values per store type: https://ebourg.github.io/jsign/
SIGN_JSIGN_STORETYPE=
SIGN_JSIGN_KEYSTORE=
SIGN_JSIGN_ALIAS=
SIGN_JSIGN_STOREPASS=
SIGN_JSIGN_CERTFILE=

# --- azure: Azure Artifact Signing (formerly Trusted Signing) ---
# Requires the Azure CLI installed and signed in (az login) on this machine.
AZURE_SIGNING_ENDPOINT=https://eus.codesigning.azure.net
AZURE_SIGNING_ACCOUNT=
AZURE_SIGNING_PROFILE=

# Optional: a different RFC 3161 timestamp server.
SIGN_TIMESTAMP_URL=
